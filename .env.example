# ── Base PostgreSQL ──────────────────────────────────────────
# Fournie par Railway (New → Database → PostgreSQL), à référencer dans le
# service de l'app : ${{Postgres.DATABASE_URL}}. Obligatoire : sans base,
# le serveur refuse de démarrer.
DATABASE_URL=postgresql://user:password@localhost:5432/vigie_qualiopi

# ── Session ──────────────────────────────────────────────────
# Clé de signature du cookie de session. Obligatoire en production.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── Google OAuth (connexion + Drive) ─────────────────────────
# Console : https://console.cloud.google.com
#  - API Google Drive ET API Google Sheets activées
#  - Identifiant OAuth de type « Application Web »
#  - Écran de consentement : scopes openid, email, profile, drive.readonly,
#    spreadsheets.readonly (lecture du classeur de suivi : l'export CSV de
#    Drive ne rendrait que le premier onglet et perdrait les fusions)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit être IDENTIQUE à l'URI de redirection autorisée côté Google.
#  - en local (via le proxy Vite) : http://localhost:5173/auth/google/callback
#  - en production : https://<domaine-railway>/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ── Accès ────────────────────────────────────────────────────
# Adresses Google autorisées à se connecter en admin la première fois
# (séparées par des virgules). Ensuite, c'est la table utilisateurs qui
# fait foi : retirer une adresse ici ne retire pas un compte existant.
ADMIN_EMAILS=actions.a2c@gmail.com

# Adresses créées en CONTRIBUTEUR à la première connexion : elles peuvent
# tout consulter, ajouter des stagiaires, gérer les abandons et générer
# des documents, mais rien configurer. Une adresse présente aussi dans
# ADMIN_EMAILS devient admin.
CONTRIBUTEUR_EMAILS=

# Seul compte Google dont l'accès Drive (lecture seule) est accepté.
DRIVE_ACCOUNT_EMAIL=actions.a2c@gmail.com

# ── Phase 2 : génération de documents ────────────────────────
# Nom injecté dans les documents via le marqueur {{nom_organisme}}.
ORGANISME_NOM=A2C
# Dossier Drive où sont déposés les documents générés. L'application le
# cherche par son nom et le crée s'il n'existe pas.
DRIVE_RACINE=A2C Qualiopi
# Facultatif : impose un dossier parent précis, par son identifiant.
DRIVE_RACINE_ID=
